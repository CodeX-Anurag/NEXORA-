# NEXORA Environment Configuration Template
# Copy this file to .env and provide your production environment secrets.

# Node Environment & Server Port
NODE_ENV=production
PORT=5000

# Backend Connection & CORS Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nexora_prod?retryWrites=true&w=majority
CLIENT_URL=https://your-production-frontend-domain.com

# Authentication Secrets
JWT_SECRET=<your-strong-production-jwt-secret-min-32-chars>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Phase 5 AI LLM Provider Configuration
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=<your-production-openai-api-key>

# Phase 8A Embedding Provider Configuration
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
EMBEDDING_API_KEY=<your-production-embedding-api-key>

# Phase 9A Security & Rate-Limiting Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AI_RATE_LIMIT_MAX=20
