# Server Configuration
NODE_ENV=development
PORT=5000

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/nexora_db

# Frontend Client URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173

# Security & JWT Configuration
JWT_SECRET=nexora_dev_secret_key_change_in_production_32bytes
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# AI & LLM Provider Settings
# Provider options: "gemini" | "openai" | "mock"
# --- Gemini (recommended, free tier) ---
LLM_PROVIDER=gemini
LLM_API_KEY=your-gemini-api-key-here
LLM_MODEL=gemini-1.5-flash

# --- OpenAI (alternative) ---
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini

# --- Mock (offline development only) ---
# LLM_PROVIDER=mock
# LLM_API_KEY=mock-key-for-development
# LLM_MODEL=mock-model
